# ---- App / JWT ----
APP_NAME="Bank Reconciliation Agent"
APP_ENV="local"
API_V1_PREFIX="/api/v1"

JWT_SECRET_KEY="dev-insecure-secret-change-me-please-set-env"
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES="720"

DEMO_USER_PASSWORD="demo12345"

# ---- Storage / Runtime ----
MYSQL_DSN="mysql+pymysql://root:password@127.0.0.1:3306/AI_agent"
CHROMA_PATH="./chroma_data"
UPLOAD_DIR="./uploads"

# ---- Checkpoint ----
CHECKPOINT_ENABLED="false"
CHECKPOINT_SQLITE_PATH="./data/checkpoint.sqlite"

# ---- Redis / Queue ----
REDIS_DSN="redis://127.0.0.1:6379/0"
ASYNC_QUEUE_ENABLED="false"
JOB_IDEMPOTENCY_TTL_SECONDS="3600"
ARQ_JOB_MAX_ATTEMPTS="3"
ARQ_JOB_TIMEOUT_SECONDS="300"
RECONCILIATION_MAX_CONCURRENCY="6"

# ---- LLM / Cache / Rate Limit ----
LLM_PROVIDER="fake"
DEEPSEEK_API_KEY=""
DEEPSEEK_MODEL="deepseek-v4-pro"
DEEPSEEK_BASE_URL="https://api.deepseek.com"

LLM_TIMEOUT_SECONDS="30.0"
LLM_MAX_ATTEMPTS="3"
LLM_BACKOFF_BASE_SECONDS="0.5"
LLM_BACKOFF_MAX_SECONDS="2.0"
LLM_BREAKER_FAIL_THRESHOLD="3"
LLM_BREAKER_OPEN_SECONDS="30"

ENABLE_LLM_CACHE="false"
LLM_CACHE_TTL_SECONDS="604800"

ENABLE_LLM_RATE_LIMIT="false"
LLM_RATE_LIMIT_RPM="60"
LLM_RATE_LIMIT_MAX_CONCURRENCY="8"
LLM_RATE_LIMIT_MAX_WAIT_SECONDS="10.0"
LLM_RATE_LIMIT_WINDOW_SECONDS="60"

# ---- RAG ----
EMBEDDING_BACKEND="bge_m3"

ENABLE_RAG_REWRITE="false"
ENABLE_RAG_HYBRID="false"
ENABLE_RAG_RERANKER="false"

RAG_DENSE_TOP_N="20"
RAG_BM25_TOP_N="20"
RAG_RERANK_TOP_K="5"
RAG_RRF_K="60"

RAG_DENSE_MIN_SCORE="0.341"
RAG_DENSE_MIN_SCORE_BGE_SMALL="0.507"
RAG_DENSE_MIN_SCORE_BGE_M3="0.510"
RAG_RERANKER_MIN_SCORE="0.3"
RAG_LOW_SCORE="0.5"
RAG_BREAKER_FAIL_THRESHOLD="5"
RAG_BREAKER_OPEN_SECONDS="30"

# ---- Misc ----
CUTOFF_WINDOW="22:00-24:00"
DECISION_REGRESSION_RUNS="10"
MAX_UPLOAD_BYTES="10485760"
MAX_UPLOAD_ROWS="10000"
